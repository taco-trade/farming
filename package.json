{
  "name": "xalpaca",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "scripts:bsc-test:mint": "pnpm exec hardhat run scripts/mint.ts --network bscTestnet",
    "scripts:bsc-test:swap": "pnpm exec hardhat run scripts/router_swap_single.ts --network bscTestnet",
    "scripts:bsc-test:decrease": "pnpm exec hardhat run scripts/decrease.ts --network bscTestnet",
    "deploy:bsc-test": "pnpm exec hardhat ignition deploy ./ignition/modules/Manager.ts --network bscTestnet --parameters ignition/parameters.json --verify",
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy:bsctestnet:manager": "hardhat --network bscTestnet deploy --no-compile --reset --tags Manager",
    "deploy:bsctestnet:strategy:pancakeswapv3:mint": "hardhat --network bscTestnet deploy --no-compile --reset --tags PancakeSwapV3Mint",
    "deploy:bsctestnet:strategy:pancakeswapv3": "VERIFY=true hardhat --network bscTestnet deploy --no-compile --reset --tags PancakeswapV3Strategies",
    "upgrade:bsctestnet:strategy:pancakeswapv3": "VERIFY=true hardhat --network bscTestnet deploy --no-compile --reset --tags UpgradePancakeswapV3Strategies",
    "deploy:bsctestnet:strategy:pancakeswapv3:execAddBaseTokenOnly": "hardhat --network bscTestnet deploy --no-compile --reset --tags ExecPancakeswapV3StrategiesAddBaseTokenOnly",
    "exec:bsctestnet:strategy:pancakeswapv3:AddBaseTokenOnlyWithCalculate": "hardhat --network bscTestnet deploy --no-compile --reset --tags ExecPancakeswapV3StrategiesAddBaseTokenOnlyWithCalculate",
    "deploy:bsctestnet:MockToken": "VERIFY=true hardhat --network bscTestnet deploy --no-compile --reset --tags MockToken",
    "deploy:bsctestnet:ExecMockToken": "VERIFY=true hardhat --network bscTestnet deploy --no-compile --reset --tags ExecMockToken",
    "deploy:bsctestnet:printInfo": "hardhat --network bscTestnet deploy --no-compile --reset --tags PrintInfo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.10",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.10",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@openzeppelin/contracts-upgradeable": "^5.2.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.19",
    "hardhat-deploy": "^0.14.0",
    "solhint": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
